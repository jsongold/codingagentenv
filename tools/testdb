#!/usr/bin/env bash
# testdb — one shared test Postgres container per machine, one database per worktree.
#   testdb up               create/start the container (idempotent)
#   testdb url <worktree>   ensure that worktree's database exists; print its URL
# Env (defaults match the original morphloop-testdb): TESTDB_CONTAINER, TESTDB_IMAGE,
# TESTDB_PORT, TESTDB_MEMORY, TESTDB_USER, TESTDB_PASSWORD, TESTDB_PREFIX (db name
# prefix), TESTDB_EXTENSIONS (created in every db), TESTDB_SCHEME (URL scheme).
# The password is a throwaway for a container bound to 127.0.0.1 only.
set -euo pipefail
c=${TESTDB_CONTAINER:-morphloop-testdb}
image=${TESTDB_IMAGE:-pgvector/pgvector:pg16}
port=${TESTDB_PORT:-55432}
mem=${TESTDB_MEMORY:-256m}
user=${TESTDB_USER:-morphloop_test}
pass=${TESTDB_PASSWORD:-morphloop_test}
prefix=${TESTDB_PREFIX:-mlp}
exts=${TESTDB_EXTENSIONS:-vector pg_trgm}
scheme=${TESTDB_SCHEME:-postgresql+psycopg}

psql() { docker exec -i "$c" psql -U "$user" -d "$1" -v ON_ERROR_STOP=1 -qAt; }

up() {
  if ! docker container inspect "$c" >/dev/null 2>&1; then
    docker run -d --name "$c" --restart unless-stopped --memory "$mem" \
      -p "127.0.0.1:$port:5432" -v "$c-data:/var/lib/postgresql/data" \
      -e POSTGRES_USER="$user" -e POSTGRES_PASSWORD="$pass" -e POSTGRES_DB=postgres \
      "$image" -c shared_buffers=64MB -c max_connections=100 -c fsync=off \
      -c synchronous_commit=off -c full_page_writes=off -c work_mem=4MB -c maintenance_work_mem=32MB >/dev/null
  elif [ "$(docker container inspect -f '{{.State.Running}}' "$c")" != true ]; then
    docker start "$c" >/dev/null
  fi
  for _ in $(seq 60); do docker exec "$c" pg_isready -q -U "$user" && return 0; sleep 1; done
  echo "testdb: $c not ready after 60s" >&2
  return 1
}

url() {
  local abs name db
  abs=$(cd "${1:?usage: testdb url <worktree>}" && pwd -P)
  name=$(basename "$abs" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '_')
  db="${prefix}_${name:0:48}_$(printf %s "$abs" | shasum | cut -c1-6)" # hash: same basename, different path
  up
  if [ -z "$(echo "select 1 from pg_database where datname='$db'" | psql postgres)" ]; then
    echo "create database \"$db\"" | psql postgres >/dev/null 2>&1 || true # race: another caller made it
  fi
  { echo 'set client_min_messages=warning;'; for e in $exts; do echo "create extension if not exists $e;"; done; } | psql "$db" >/dev/null
  echo "$scheme://$user:$pass@127.0.0.1:$port/$db"
}

case "${1:-}" in
  up) up ;;
  url) url "${2:-}" ;;
  *) echo "usage: testdb up | testdb url <worktree>" >&2; exit 1 ;;
esac
