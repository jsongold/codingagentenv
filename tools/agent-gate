#!/usr/bin/env bash
# agent-gate <worktree> [steps-file] — run a project's merge gate, capped to a
# number of gates running at once on this machine (a "slot"). The slot count
# comes from, in order: AGENT_GATE_SLOTS env (if set) > cad's live capacity
# (GET ${CAD_URL:-http://127.0.0.1:7878}/v1/capacity, Bearer CAD_TOKEN if set)
# > a one-shot `cad capacity` (built from ./cad or found on PATH) > 1 if none
# of those work. It is re-evaluated every time a slot is acquired, since
# capacity changes over time. If nothing currently holds a slot and the count
# comes out 0, one gate is still allowed in (never deadlock on a small
# machine).
#
# steps-file: one shell command per line, run in order inside the worktree
# (blank lines and '#' comments skipped). Default: <worktree>/scripts/gate.steps.
# Every step runs even after a failure; exit 1 if any failed. Steps see $WT (the
# worktree) and have this directory on PATH, so they can call `testdb url "$WT"`.
# Example: examples/morphloop.gate.steps.
#
# Slots are files (holding the holder's pid) under AGENT_GATE_LOCK_DIR
# (default ${XDG_STATE_HOME:-~/.local/state}/agent-gate), claimed via link(2)
# so a claim can't silently land inside an already-held slot; a slot whose
# holder PID is dead is reclaimed.
set -uo pipefail

# cad_curl <curl args...> — adds the Bearer token when CAD_TOKEN is set.
cad_curl() {
  if [ -n "${CAD_TOKEN:-}" ]; then
    curl -H "Authorization: Bearer $CAD_TOKEN" "$@"
  else
    curl "$@"
  fi
}

# parse_slots <json> — pulls the "slots":N value out with grep, no jq assumed.
parse_slots() {
  printf '%s' "$1" | grep -o '"slots"[[:space:]]*:[[:space:]]*[0-9]\+' | grep -o '[0-9]\+$' | head -1
}

# get_slots — the precedence chain described in the header comment.
get_slots() {
  if [ -n "${AGENT_GATE_SLOTS:-}" ]; then
    printf '%s' "$AGENT_GATE_SLOTS"
    return
  fi
  local url="${CAD_URL:-http://127.0.0.1:7878}/v1/capacity" body n
  if body=$(cad_curl -fsS --max-time 2 "$url" 2>/dev/null); then
    n=$(parse_slots "$body")
    [ -n "$n" ] && { printf '%s' "$n"; return; }
  fi
  if command -v cad >/dev/null 2>&1 && body=$(cad capacity 2>/dev/null); then
    n=$(parse_slots "$body")
    [ -n "$n" ] && { printf '%s' "$n"; return; }
  fi
  printf '1'
}

# count_alive — reclaims any slot file whose holder PID is confirmed dead,
# echoes how many slots (of any index) are still held by a live PID. A slot
# file is only ever created already containing its pid (see acquire_slot), so
# an empty/unreadable file here means something else is mid-acquisition, not
# dead — leave it alone rather than reclaim it out from under that process.
count_alive() {
  local d pid alive=0
  for d in "$base"/slot.*; do
    [ -f "$d" ] || continue
    pid=$(cat "$d" 2>/dev/null)
    if [ -z "$pid" ]; then
      alive=$((alive + 1)) # mid-acquisition (or unreadable): assume live, don't reclaim
    elif kill -0 "$pid" 2>/dev/null; then
      alive=$((alive + 1))
    else
      # ponytail: stale check races if two waiters reap the same file at once; worst case one extra gate runs briefly
      rm -f "$d"
    fi
  done
  printf '%s' "$alive"
}

# acquire_slot <n> — atomically claims the first free slot.1..slot.n: writes
# the pid into a private temp file, then hard-links it into place. A slot is
# a plain file (not a directory) specifically so that link(2) either creates
# it outright or fails with EEXIST — unlike `mv`, which silently moves its
# source *into* an existing directory target and reports success, letting a
# late competitor believe it had won a slot someone else already held. Sets
# the global $slot on success.
acquire_slot() {
  local n=$1 i d tmp
  for i in $(seq "$n" 2>/dev/null); do
    d="$base/slot.$i"
    [ -e "$d" ] && continue
    tmp=$(mktemp "$base/.slot.tmp.XXXXXX" 2>/dev/null) || continue
    echo $$ >"$tmp"
    if ln "$tmp" "$d" 2>/dev/null; then
      rm -f "$tmp"
      slot=$d
      return 0
    fi
    rm -f "$tmp"
  done
  return 1
}

# wait_step <seconds> — long-polls cad's capacity SSE stream for a real change
# (its 2nd "data:" line: the 1st is always the just-connected snapshot),
# bounded by --max-time; falls back to a plain sleep when cad isn't reachable
# or nothing changes. Checks grep's own exit status via PIPESTATUS rather than
# the pipeline's (pipefail would otherwise fail this on curl's own non-zero
# exit — e.g. a write error when grep closes the pipe right after matching,
# or its own --max-time timeout — masking a real early wake).
wait_step() {
  local timeout=$1 t0=$SECONDS elapsed
  cad_curl -sN --max-time "$timeout" "${CAD_URL:-http://127.0.0.1:7878}/v1/events?topics=capacity" 2>/dev/null | grep -m2 -q '^data:'
  if [ "${PIPESTATUS[1]}" -ne 0 ]; then
    elapsed=$((SECONDS - t0))
    [ "$elapsed" -lt "$timeout" ] && sleep "$((timeout - elapsed))"
  fi
}

# main <worktree> [steps-file] — everything argument-dependent lives here (not
# at top level) so this file can be `source`d for testing its functions
# (cad_curl, parse_slots, get_slots, count_alive, acquire_slot, wait_step)
# without also running a gate.
main() {
  local here WT steps base slot t0 waited alive n log fail c start rc
  here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
  export PATH="$here:$PATH"
  WT=$(cd "${1:?usage: agent-gate <worktree> [steps-file]}" && pwd) || exit 2
  export WT
  steps=${2:-$WT/scripts/gate.steps}
  [ -f "$steps" ] || { echo "agent-gate: no steps file: $steps" >&2; exit 2; }
  steps=$(cd "$(dirname "$steps")" && pwd)/$(basename "$steps")
  base=${AGENT_GATE_LOCK_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-gate}
  mkdir -p "$base"

  slot=""
  trap '[ -n "$slot" ] && rm -f "$slot"' EXIT
  trap 'exit 130' INT TERM HUP
  waited=0
  while [ -z "$slot" ]; do
    alive=$(count_alive)
    n=$(get_slots)
    if [ "$n" -le 0 ] 2>/dev/null && [ "$alive" -eq 0 ]; then n=1; fi
    if [ "$alive" -lt "$n" ] 2>/dev/null; then
      acquire_slot "$n"
    fi
    if [ -z "$slot" ]; then
      [ $((waited % 30)) -eq 0 ] && echo "gate: waiting for a slot (${waited}s; holders: $(cat "$base"/slot.* 2>/dev/null | tr '\n' ' '))"
      t0=$SECONDS
      wait_step 5
      waited=$((waited + SECONDS - t0))
    fi
  done
  echo "gate: acquired $slot for $WT"
  cd "$WT" || exit 2
  log=$(mktemp)
  fail=0
  while IFS= read -r c || [ -n "$c" ]; do
    case $c in '' | '#'*) continue ;; esac
    start=$SECONDS
    eval "$c" >"$log" 2>&1 </dev/null
    rc=$?
    echo "[$rc] $c ($((SECONDS - start))s)"
    if [ $rc -ne 0 ]; then fail=1; tail -25 "$log"; else tail -1 "$log"; fi
  done <"$steps"
  rm -f "$log"
  echo "gate: overall $([ $fail -eq 0 ] && echo PASS || echo FAIL)"
  exit $fail
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
