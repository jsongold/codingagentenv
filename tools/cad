#!/usr/bin/env bash
# cad [args] — run the cad metadata server (see cad/main.go for env: CAD_ADDR,
# CAD_TOKEN, CAD_POLICY, CAD_SLOTS). Builds cad/bin/cad (gitignored) when it is
# missing or older than the Go sources.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
src=$(cd "$here/../cad" && pwd)
bin=$src/bin/cad
if [ ! -x "$bin" ] || [ -n "$(find "$src" -maxdepth 1 \( -name '*.go' -o -name go.mod \) -newer "$bin")" ]; then
  (cd "$src" && go build -o bin/cad .)
fi
exec "$bin" "$@"
