{
  "agents": ["claude/a12e00a7", "claude/b1c8ef41", "codex/2e33b72a", "opencode/996c87ae"],
  "computers": ["local", "cloud-run-jobs", "gce-spot", "gce-std", "e2b", "claude-cloud"],
  "cadAddr": "127.0.0.1:17878",
  "rules": [
    { "agent": "self", "computer": "claude-cloud" },
    { "agent": "opencode/*", "computer": "gce-spot" }, { "agent": "opencode/*", "computer": "gce-std" },
    { "agent": "self", "computer": "local" }, { "agent": "opencode/*", "computer": "local" }
  ],
  "modes": {
    "urgent": { "cadAddr": "127.0.0.1:7878", "rules": [
      { "agent": "self", "computer": "local" }, { "agent": "opencode/*", "computer": "local" },
      { "agent": "self", "computer": "claude-cloud" },
      { "agent": "opencode/*", "computer": "gce-spot" }, { "agent": "opencode/*", "computer": "gce-std" }
    ] },
    "sleep": { "rules": [
      { "agent": "claude/*", "computer": "claude-cloud" },
      { "agent": "opencode/*", "computer": "gce-spot" }, { "agent": "opencode/*", "computer": "gce-std" }
    ] }
  },
  "placement": { "reservePct": 15, "staleUsage": "pass" },
  "classes": {
    "light-edit":   { "criteria": "docs/config/コメントのみ。テストの追加・変更なし", "estPct": 1 },
    "gate-heavy":   { "criteria": "コード変更があり、テスト・型チェック・lint の通過が必要", "estPct": 4 },
    "needs-db":     { "criteria": "DB（Postgres 等）やコンテナを起動するテストが必要", "estPct": 6 },
    "long-running": { "criteria": "45 分を超える見込み（大きな移行・E2E）", "estPct": 8 },
    "urgent":       { "criteria": "owner が結果を待っている（対話中の依頼）", "estPct": 4 },
    "retry":        { "criteria": "前回失敗・中断した task の再実行", "estPct": 4 }
  },
  "runners": {
    "claude":   { "mode": "subagent" },
    "claude@claude-cloud": { "mode": "cloud", "cmd": "claude --cloud" },
    "opencode": { "mode": "process", "cmd": "opencode run --model {model}", "model": "opencode-go/deepseek-v4-pro" },
    "opencode@gce-spot": { "mode": "vm", "instance": "worker-spot", "zone": "us-central1-a", "project": "suggestorder-dev",
      "image": "ghcr.io/jsongold/codingagentenv/opencode-worker:main", "model": "opencode-go/deepseek-v4-pro" },
    "opencode@gce-std": { "mode": "vm", "instance": "worker-std", "zone": "us-central1-a", "project": "suggestorder-dev",
      "image": "ghcr.io/jsongold/codingagentenv/opencode-worker:main", "model": "opencode-go/deepseek-v4-pro" }
  }
}
