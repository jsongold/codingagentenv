{
  "version": 1,
  "gate": { "memoryMB": 1500, "cpus": 1, "reserveMB": 2048, "maxSlots": 5 },
  "review": { "reviewers": ["codex-bot", "codex-local", "claude-opus"], "excludeImplementer": true, "requireCI": true },
  "providers": { "allowed": ["cloud-run-jobs", "local", "claude-cloud", "gce-spot", "e2b"] },
  "computers": {
    "local":          { "vcpuHourUSD": 0,      "gibHourUSD": 0,       "minBillSec": 0,  "preemptible": false, "coldStartSec": 0,  "caps": { "docker": true,  "db": true  }, "maxMemMB": 16384, "maxCpus": 8, "maxMin": 0 },
    "cloud-run-jobs": { "vcpuHourUSD": 0.0648, "gibHourUSD": 0.0072,  "minBillSec": 60, "preemptible": false, "coldStartSec": 20, "caps": { "docker": false, "db": false }, "maxMemMB": 32768, "maxCpus": 8, "maxMin": 10080 },
    "gce-spot":       { "vcpuHourUSD": 0.0258, "gibHourUSD": 0.00645, "minBillSec": 60, "preemptible": true,  "coldStartSec": 90, "caps": { "docker": true,  "db": true  }, "maxMemMB": 8192,  "maxCpus": 2, "maxMin": 0 },
    "e2b":            { "vcpuHourUSD": 0.0504, "gibHourUSD": 0.0162,  "minBillSec": 1,  "preemptible": false, "coldStartSec": 1,  "caps": { "docker": false, "db": true  }, "maxMemMB": 8192,  "maxCpus": 8, "maxMin": 60 },
    "claude-cloud":   { "vcpuHourUSD": 0,      "gibHourUSD": 0,       "minBillSec": 0,  "preemptible": false, "coldStartSec": 30, "caps": { "docker": true,  "db": true  }, "maxMemMB": 8192,  "maxCpus": 4, "maxMin": 0 }
  },
  "agents": ["claude/a12e00a7", "claude/b1c8ef41", "codex/2e33b72a", "opencode/996c87ae"],
  "rules": [{ "agent": "self", "computer": "local" }, { "agent": "opencode/*", "computer": "local" }],
  "placement": { "reservePct": 15 },
  "classes": {
    "light-edit":   { "criteria": "docs/config/コメントのみ。テストの追加・変更なし", "estPct": 1 },
    "gate-heavy":   { "criteria": "コード変更があり、テスト・型チェック・lint の通過が必要", "estPct": 4 },
    "needs-db":     { "criteria": "DB（Postgres 等）やコンテナを起動するテストが必要", "estPct": 6 },
    "long-running": { "criteria": "45 分を超える見込み（大きな移行・E2E）", "estPct": 8 },
    "urgent":       { "criteria": "owner が結果を待っている（対話中の依頼）", "estPct": 4 },
    "retry":        { "criteria": "前回失敗・中断した task の再実行", "estPct": 4 }
  },
  "runners": {
    "claude":   { "mode": "subagent" },
    "opencode": { "mode": "process", "cmd": "opencode run --model {model}", "model": "opencode-go/deepseek-v4-pro" }
  },
  "collect": { "usage": { "every": "60s" } }
}
