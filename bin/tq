#!/usr/bin/env node
// tq — minimal file-backed task queue for Claude Code subagents.
// Storage: one JSON task per line in queue/tasks.jsonl (override with TQ_FILE).
'use strict';

const fs = require('fs');
const path = require('path');

const FILE = process.env.TQ_FILE || path.join(__dirname, '..', 'queue', 'tasks.jsonl');
const LOCK = FILE + '.lock';
const STATES = ['queued', 'running', 'done', 'failed'];

function sleep(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

// mkdir is atomic, so it doubles as a cross-process mutex.
function withLock(fn) {
  fs.mkdirSync(path.dirname(FILE), { recursive: true });
  const deadline = Date.now() + 5000;
  for (;;) {
    try {
      fs.mkdirSync(LOCK);
      break;
    } catch (e) {
      if (e.code !== 'EEXIST') throw e;
      if (Date.now() > deadline) die(`lock timeout: ${LOCK} (remove it if no tq process is running)`);
      sleep(20);
    }
  }
  try {
    return fn();
  } finally {
    fs.rmdirSync(LOCK);
  }
}

function load() {
  if (!fs.existsSync(FILE)) return [];
  return fs
    .readFileSync(FILE, 'utf8')
    .split('\n')
    .filter((l) => l.trim())
    .map((l, i) => {
      try {
        return JSON.parse(l);
      } catch {
        die(`corrupt line ${i + 1} in ${FILE}`);
      }
    });
}

function save(tasks) {
  const tmp = `${FILE}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, tasks.map((t) => JSON.stringify(t)).join('\n') + (tasks.length ? '\n' : ''));
  fs.renameSync(tmp, FILE);
}

// Throws instead of exiting so withLock's finally always releases the lock.
class TqError extends Error {}
function die(msg) {
  throw new TqError(msg);
}

function parseArgs(argv) {
  const pos = [];
  const opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const val = argv[i + 1];
      if (val === undefined || val.startsWith('--')) die(`option --${key} needs a value`);
      opt[key] = val;
      i++;
    } else {
      pos.push(a);
    }
  }
  return { pos, opt };
}

function nextId(tasks) {
  const max = tasks.reduce((m, t) => Math.max(m, Number(t.id.slice(2)) || 0), 0);
  return `T-${String(max + 1).padStart(3, '0')}`;
}

function find(tasks, id) {
  const t = tasks.find((x) => x.id === id);
  if (!t) die(`no such task: ${id}`);
  return t;
}

function transition(id, from, to, note) {
  return withLock(() => {
    const tasks = load();
    const t = find(tasks, id);
    if (!from.includes(t.state)) die(`${id} is ${t.state}; expected ${from.join('|')}`);
    t.state = to;
    t.updated_at = new Date().toISOString();
    if (note) t.note = note;
    save(tasks);
    return t;
  });
}

const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');

const commands = {
  enqueue({ pos, opt }) {
    const title = pos.join(' ').trim();
    if (!title) die('usage: tq enqueue <title> [--agent <type>] [--body <text>]');
    out(
      withLock(() => {
        const tasks = load();
        const now = new Date().toISOString();
        const t = {
          id: nextId(tasks),
          title,
          state: 'queued',
          agent: opt.agent || 'general-purpose',
          created_at: now,
          updated_at: now,
        };
        if (opt.body) t.body = opt.body;
        tasks.push(t);
        save(tasks);
        return t;
      })
    );
  },

  // Claims the oldest queued task (or --id). Exit 2 when the queue is empty.
  claim({ opt }) {
    const t = withLock(() => {
      const tasks = load();
      const t = opt.id ? find(tasks, opt.id) : tasks.find((x) => x.state === 'queued');
      if (!t) return null;
      if (t.state !== 'queued') die(`${t.id} is ${t.state}; expected queued`);
      t.state = 'running';
      t.updated_at = new Date().toISOString();
      save(tasks);
      return t;
    });
    if (!t) {
      process.stderr.write('tq: queue empty\n');
      process.exit(2);
    }
    out(t);
  },

  done({ pos, opt }) {
    if (!pos[0]) die('usage: tq done <id> [--note <text>]');
    out(transition(pos[0], ['running'], 'done', opt.note));
  },

  fail({ pos, opt }) {
    if (!pos[0]) die('usage: tq fail <id> [--note <text>]');
    out(transition(pos[0], ['running'], 'failed', opt.note));
  },

  requeue({ pos, opt }) {
    if (!pos[0]) die('usage: tq requeue <id> [--note <text>]');
    out(transition(pos[0], ['running', 'failed'], 'queued', opt.note));
  },

  show({ pos }) {
    if (!pos[0]) die('usage: tq show <id>');
    out(find(load(), pos[0]));
  },

  list({ opt }) {
    if (opt.state && !STATES.includes(opt.state)) die(`unknown state: ${opt.state} (${STATES.join('|')})`);
    load()
      .filter((t) => !opt.state || t.state === opt.state)
      .forEach(out);
  },
};

const [cmd, ...rest] = process.argv.slice(2);
try {
  if (!cmd || !commands[cmd]) die(`usage: tq <${Object.keys(commands).join('|')}> ...`);
  commands[cmd](parseArgs(rest));
} catch (e) {
  if (!(e instanceof TqError)) throw e;
  process.stderr.write(`tq: ${e.message}\n`);
  process.exit(1);
}
