#!/bin/bash
# harness — deploys this repo's harness into ~/.claude. The repo is the only
# source of truth; nothing under ~/.claude is edited by hand (#93).
#
#   bin/codingenv install     symlink skills, hooks and global/harness.json,
#                           register hooks, drop retired hooks and env (#103),
#                           sync the harness section of ~/.claude/CLAUDE.md,
#                           list mods/*/ plugins in env.CLAUDE_CODE_PLUGIN_DIRS,
#                           link this command into ~/.local/bin as `codingenv`
#                           and tools/* into ~/.local/bin under their own names
#   bin/codingenv uninstall   remove everything install added
#   bin/codingenv status      report drift; exit 1 if anything is missing
#
# CLAUDE_DIR and BIN_DIR override the target directories, MODS_DIR the mods
# source (used by the tests).
set -eu

# Resolve symlinks so the script finds the repo when run as `codingenv` via PATH.
SELF=$0
while [ -L "$SELF" ]; do
  dir=$(cd "$(dirname "$SELF")" && pwd)
  SELF=$(readlink "$SELF")
  case $SELF in /*) ;; *) SELF=$dir/$SELF ;; esac
done
ROOT=$(cd "$(dirname "$SELF")/.." && pwd)
CLAUDE_DIR=${CLAUDE_DIR:-$HOME/.claude}
BIN_DIR=${BIN_DIR:-$HOME/.local/bin}
CMD=codingenv # name of the command install links into BIN_DIR
SETTINGS="$CLAUDE_DIR/settings.json"
MEMORY="$CLAUDE_DIR/CLAUDE.md"
SECTION="$ROOT/global/CLAUDE.harness.md"
CONFIG="$ROOT/global/harness.json" # linked as CLAUDE_DIR/harness.json
# The marker text is matched against the deployed ~/.claude/CLAUDE.md; do not rename it.
BEGIN='<!-- harness:begin (managed by codingagentenv bin/harness; do not edit) -->'
END='<!-- harness:end -->'
HEADING='## ハーネス（全プロジェクト共通）'
# Removed from the harness (#103); install and uninstall clean them out of
# an existing settings.json and hooks directory.
RETIRED_ENV=CLAUDE_CODE_ENABLE_TODO_TOOLS
RETIRED_HOOKS='TaskCompleted:harness-task-completed.sh'

SKILLS=$(cd "$ROOT/skills" && ls -d */ | tr -d /)
TOOLS=$(cd "$ROOT/tools" && ls) # linked into BIN_DIR under their own names
# Every mods/<name>/ with .claude-plugin/plugin.json loads as a plugin in every
# session via CLAUDE_CODE_PLUGIN_DIRS (":"-separated); no registry to edit.
MODS_DIR=${MODS_DIR:-$ROOT/mods}
MODS=$(for d in "$MODS_DIR"/*/; do [ -f "$d.claude-plugin/plugin.json" ] && printf '%s:' "${d%/}"; done; true)
MOD_NAMES=$(printf '%s' "$MODS" | tr ':' '\n' | sed 's#.*/##' | tr '\n' ':')
HOOKS='SessionStart:harness-session-start.sh PreToolUse:harness-scope-check.ts'

hook_command() {
  case "$1" in
    *.ts) printf 'node "$HOME/.claude/hooks/%s"' "$1" ;;
    *) printf 'bash "$HOME/.claude/hooks/%s"' "$1" ;;
  esac
}
# PreToolUse runs only on Bash, and only when a subcommand starts with gh.
hook_filter() { # event -> JSON merged into the group / the handler
  case "$1" in
    PreToolUse) printf '{"group":{"matcher":"Bash"},"handler":{"if":"Bash(gh *)"}}' ;;
    *) printf '{"group":{},"handler":{}}' ;;
  esac
}

backup() {
  [ -f "$1" ] && cp "$1" "$1.bak-$(date +%Y%m%d-%H%M%S)-harness"
  return 0
}

update_settings() { # jq filter, then jq args
  jq "$@" "$SETTINGS" >"$SETTINGS.tmp"
  mv "$SETTINGS.tmp" "$SETTINGS"
}

unlink_hooks() { # event:script entries; removes our symlinks only
  for entry in "$@"; do
    [ "$(readlink "$CLAUDE_DIR/hooks/${entry#*:}" 2>/dev/null)" = "$ROOT/hooks/${entry#*:}" ] && rm "$CLAUDE_DIR/hooks/${entry#*:}"
  done
  return 0
}

# Drops only our nested hook; a group goes only when its hooks array is left
# empty, and an event only when no group is left.
unregister_hooks() { # event:script entries
  for entry in "$@"; do
    update_settings --arg event "${entry%%:*}" --arg command "$(hook_command "${entry#*:}")" '
      if .hooks[$event] then
        .hooks[$event] |= map(
          if (.hooks | type) == "array" then
            .hooks |= map(select(.command != $command)) | select(.hooks != [])
          else . end)
        | if .hooks[$event] == [] then del(.hooks[$event]) else . end
      else . end'
  done
}

# jq defs: an entry is ours when it is under MODS_DIR or ends in /mods/<name>
# of one of our mods (the same mod installed from another checkout or worktree).
PLUGIN_DIRS_DEFS='
  def ours: . as $d | ($d | startswith($prefix)) or any($names | split(":")[] | select(. != ""); . as $n | $d | endswith("/mods/" + $n));
  def entries: (.env.CLAUDE_CODE_PLUGIN_DIRS // "") | split(":") | map(select(. != ""));'
# jq filter: CLAUDE_CODE_PLUGIN_DIRS with our entries replaced by $mods
# (others kept, in order); the key goes when the list ends up empty.
PLUGIN_DIRS_FILTER="$PLUGIN_DIRS_DEFS"'
  ((entries | map(select(ours | not))) + ($mods | split(":") | map(select(. != ""))) | join(":")) as $dirs
  | if $dirs == "" then del(.env.CLAUDE_CODE_PLUGIN_DIRS) else .env.CLAUDE_CODE_PLUGIN_DIRS = $dirs end
  | if .env == {} then del(.env) else . end'
# jq test: our entries are exactly $mods, in any order.
PLUGIN_DIRS_OK='(entries | map(select(ours)) | sort) == ($mods | split(":") | map(select(. != "")) | sort)'

sync_plugin_dirs() { # ":"-joined mod paths to list
  update_settings --arg mods "$1" --arg prefix "$MODS_DIR/" --arg names "$MOD_NAMES" "$PLUGIN_DIRS_FILTER"
}

drop_retired() {
  unlink_hooks $RETIRED_HOOKS
  update_settings --arg key "$RETIRED_ENV" 'del(.env[$key]) | if .env == {} then del(.env) else . end'
  unregister_hooks $RETIRED_HOOKS
}

# Prints CLAUDE.md without the harness section: the marked block, or a section
# added by hand before markers existed (heading up to the next "## ").
strip_section() {
  awk -v begin="$BEGIN" -v end="$END" -v heading="$HEADING" '
    $0 == begin { skip = "marked"; next }
    skip == "marked" { if ($0 == end) skip = ""; next }
    $0 == heading { skip = "legacy"; next }
    skip == "legacy" && /^## / { skip = "" }
    skip == "legacy" { next }
    { print }
  ' "$MEMORY"
}

install() {
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  # Refuse to overwrite an unrelated file that already owns the command name.
  if [ -e "$BIN_DIR/$CMD" ] && [ ! -L "$BIN_DIR/$CMD" ]; then
    echo "$BIN_DIR/$CMD exists and is not a symlink; move it away first" >&2
    exit 1
  fi
  mkdir -p "$CLAUDE_DIR/skills" "$CLAUDE_DIR/hooks" "$BIN_DIR"

  ln -sfn "$ROOT/bin/codingenv" "$BIN_DIR/$CMD"
  for name in $TOOLS; do
    if [ -e "$BIN_DIR/$name" ] && [ ! -L "$BIN_DIR/$name" ]; then
      echo "skip tool $name: $BIN_DIR/$name exists and is not a symlink" >&2
    else
      ln -sfn "$ROOT/tools/$name" "$BIN_DIR/$name"
    fi
  done
  for name in $SKILLS; do
    ln -sfn "$ROOT/skills/$name" "$CLAUDE_DIR/skills/$name"
  done
  for entry in $HOOKS; do
    ln -sfn "$ROOT/hooks/${entry#*:}" "$CLAUDE_DIR/hooks/${entry#*:}"
  done
  if [ -e "$CLAUDE_DIR/harness.json" ] && [ ! -L "$CLAUDE_DIR/harness.json" ]; then
    echo "skip harness.json: $CLAUDE_DIR/harness.json exists and is not a symlink" >&2
  else
    ln -sfn "$CONFIG" "$CLAUDE_DIR/harness.json"
  fi

  [ -f "$SETTINGS" ] || echo '{}' >"$SETTINGS"
  backup "$SETTINGS"
  drop_retired
  for entry in $HOOKS; do
    # Append a group unless one already runs the same script.
    update_settings --arg event "${entry%%:*}" --arg command "$(hook_command "${entry#*:}")" \
      --argjson filter "$(hook_filter "${entry%%:*}")" '
      .hooks[$event] //= []
      | if any(.hooks[$event][]?.hooks[]?; .command == $command) then .
        else .hooks[$event] += [$filter.group + {hooks: [{type: "command", command: $command, timeout: 10} + $filter.handler]}]
        end'
  done
  sync_plugin_dirs "$MODS"

  [ -f "$MEMORY" ] || : >"$MEMORY"
  backup "$MEMORY"
  { strip_section; echo "$BEGIN"; cat "$SECTION"; echo "$END"; } >"$MEMORY.tmp"
  mv "$MEMORY.tmp" "$MEMORY"

  echo "installed into $CLAUDE_DIR and linked $BIN_DIR/$CMD. Restart Claude Code to pick up the hooks."
  case ":$PATH:" in *":$BIN_DIR:"*) ;; *) echo "note: $BIN_DIR is not on PATH" >&2 ;; esac
}

uninstall() {
  [ "$(readlink "$BIN_DIR/$CMD" 2>/dev/null)" = "$ROOT/bin/codingenv" ] && rm "$BIN_DIR/$CMD"
  for name in $TOOLS; do
    [ "$(readlink "$BIN_DIR/$name" 2>/dev/null)" = "$ROOT/tools/$name" ] && rm "$BIN_DIR/$name"
  done
  for name in $SKILLS; do
    [ "$(readlink "$CLAUDE_DIR/skills/$name" 2>/dev/null)" = "$ROOT/skills/$name" ] && rm "$CLAUDE_DIR/skills/$name"
  done
  unlink_hooks $HOOKS $RETIRED_HOOKS
  [ "$(readlink "$CLAUDE_DIR/harness.json" 2>/dev/null)" = "$CONFIG" ] && rm "$CLAUDE_DIR/harness.json"
  if [ -f "$SETTINGS" ]; then
    backup "$SETTINGS"
    drop_retired
    unregister_hooks $HOOKS
    sync_plugin_dirs ""
  fi

  if [ -f "$MEMORY" ]; then
    backup "$MEMORY"
    strip_section >"$MEMORY.tmp"
    mv "$MEMORY.tmp" "$MEMORY"
  fi

  echo "uninstalled from $CLAUDE_DIR"
}

status() {
  local drift=0
  report() { # label, ok?
    if [ "$2" = yes ]; then echo "ok      $1"; else echo "MISSING $1"; drift=1; fi
  }
  same() { [ "$1" = "$2" ] && echo yes || echo no; }

  report "command $CMD" "$(same "$(readlink "$BIN_DIR/$CMD" 2>/dev/null)" "$ROOT/bin/codingenv")"
  for name in $TOOLS; do
    report "tool $name" "$(same "$(readlink "$BIN_DIR/$name" 2>/dev/null)" "$ROOT/tools/$name")"
  done
  for name in $SKILLS; do
    report "skill $name" "$(same "$(readlink "$CLAUDE_DIR/skills/$name" 2>/dev/null)" "$ROOT/skills/$name")"
  done
  report "config harness.json" "$(same "$(readlink "$CLAUDE_DIR/harness.json" 2>/dev/null)" "$CONFIG")"
  for entry in $HOOKS; do
    local script=${entry#*:} event=${entry%%:*}
    report "hook script $script" "$(same "$(readlink "$CLAUDE_DIR/hooks/$script" 2>/dev/null)" "$ROOT/hooks/$script")"
    report "hook registered $event" "$(jq -r --arg event "$event" --arg command "$(hook_command "$script")" \
      'if any(.hooks[$event][]?.hooks[]?; .command == $command) then "yes" else "no" end' "$SETTINGS" 2>/dev/null || echo no)"
  done
  for entry in $RETIRED_HOOKS; do
    local script=${entry#*:} event=${entry%%:*}
    report "retired hook script $script removed" "$([ "$(readlink "$CLAUDE_DIR/hooks/$script" 2>/dev/null)" = "$ROOT/hooks/$script" ] && echo no || echo yes)"
    report "retired hook $event unregistered" "$(jq -r --arg event "$event" --arg command "$(hook_command "$script")" \
      'if any(.hooks[$event][]?.hooks[]?; .command == $command) then "no" else "yes" end' "$SETTINGS" 2>/dev/null || echo yes)"
  done
  report "env CLAUDE_CODE_PLUGIN_DIRS lists mods" "$(jq -r --arg mods "$MODS" --arg prefix "$MODS_DIR/" --arg names "$MOD_NAMES" \
    "$PLUGIN_DIRS_DEFS if $PLUGIN_DIRS_OK then \"yes\" else \"no\" end" "$SETTINGS" 2>/dev/null || echo no)"
  report "env $RETIRED_ENV removed" "$(same "$(jq -r --arg key "$RETIRED_ENV" '.env[$key] // ""' "$SETTINGS" 2>/dev/null)" "")"

  local current=""
  [ -f "$MEMORY" ] && current=$(awk -v begin="$BEGIN" -v end="$END" '$0 == end { f = 0 } f { print } $0 == begin { f = 1 }' "$MEMORY")
  report "CLAUDE.md harness section up to date" "$(same "$current" "$(cat "$SECTION")")"

  return $drift
}

case "${1:-}" in
  install | uninstall | status) "$1" ;;
  *) echo "usage: bin/codingenv <install|uninstall|status>" >&2; exit 1 ;;
esac
